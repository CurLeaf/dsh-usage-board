{
  "name": "@qzsy/dsh-usage-board",
  "version": "0.3.0",
  "description": "DSH Web 左栏用量看板：New API（quota 口径）与 WandAPI（USD 口径）两个供应商可切换，按供应商能力渲染，失败即进失效视图。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "author": "qzsy",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "usage",
    "new-api",
    "wandapi",
    "sidebar",
    "billing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurLeaf/dsh-usage-board.git"
  },
  "homepage": "https://github.com/CurLeaf/dsh-usage-board#readme",
  "bugs": {
    "url": "https://github.com/CurLeaf/dsh-usage-board/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
